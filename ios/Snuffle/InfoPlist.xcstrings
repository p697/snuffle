        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्रोजेक्ट आइकन के लिए फ़ोटो लें। फ़ोटो सिर्फ़ इसी iPhone पर रहती है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
