        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tira uma fotografia para o ícone do projeto. A fotografia fica neste iPhone."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Снимите фото для значка проекта. Фото останется на этом iPhone."
