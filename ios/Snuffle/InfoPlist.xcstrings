        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "프로젝트 아이콘으로 사용할 사진을 찍어요. 사진은 이 iPhone에만 저장돼요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tire uma foto para o ícone do projeto. A foto fica neste iPhone."
