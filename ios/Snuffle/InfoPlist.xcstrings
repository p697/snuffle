  "strings" : {
    "NSCameraUsageDescription" : {
      "comment" : "Asked before the camera opens to take a project icon.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "التقط صورة لأيقونة المشروع. تبقى الصورة على هذا الـ iPhone."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nimm ein Foto für ein Projektsymbol auf. Das Foto bleibt auf diesem iPhone."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Take a photo for a project icon. The photo stays on this iPhone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz una foto para el icono del proyecto. La foto se queda en este iPhone."
