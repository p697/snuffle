    "回复会公开显示在 App Store，Apple 审核后才会出现，通常需要一天。" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تظهر الردود علنًا على App Store بعد أن تراجعها Apple، عادةً خلال يوم."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antworten erscheinen öffentlich im App Store, nachdem Apple sie geprüft hat – meist innerhalb eines Tages."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Replies are public on the App Store and appear after Apple reviews them, usually within a day."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las respuestas son públicas en el App Store y aparecen cuando Apple las revisa, normalmente en un día."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las respuestas son públicas en el App Store y aparecen cuando Apple las revisa, normalmente en un día."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les réponses sont publiques sur l'App Store et apparaissent après examen par Apple, généralement sous un jour."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जवाब App Store पर सार्वजनिक होते हैं और Apple की समीक्षा के बाद दिखते हैं, आमतौर पर एक दिन के भीतर।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le risposte sono pubbliche sull'App Store e appaiono dopo la revisione di Apple, di solito entro un giorno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "返信はApp Storeで公開され、Appleの審査後に表示されます。通常1日ほどかかります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "답변은 App Store에 공개되며, Apple의 심사를 거친 후 표시돼요. 보통 하루 정도 걸려요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As respostas ficam públicas na App Store e aparecem depois que a Apple as analisa, geralmente em até um dia."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As respostas são públicas na App Store e aparecem depois de a Apple as rever, normalmente no prazo de um dia."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ответы публикуются в App Store после проверки Apple — обычно в течение дня."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คำตอบจะแสดงต่อสาธารณะบน App Store และจะปรากฏหลังจาก Apple ตรวจสอบ ซึ่งมักใช้เวลาไม่เกินหนึ่งวัน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yanıtlar App Store’da herkese açık görünür ve Apple incelemesinden sonra yayımlanır; bu genellikle bir gün sürer."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Відповіді публікуються в App Store після перевірки Apple — зазвичай протягом дня."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Câu trả lời hiển thị công khai trên App Store và xuất hiện sau khi Apple xét duyệt, thường trong vòng một ngày."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "回覆會公開顯示在 App Store，經 Apple 審核後才會出現，通常需要一天。"
          }
        }
      }
    },
    "回复会公开显示在 Google Play，评论者会收到通知。" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
