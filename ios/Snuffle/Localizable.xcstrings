    "登录过的账号会保留，下次添加时可以直接用。" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تبقى الحسابات المسجّلة محفوظة لتستخدمها في المرة القادمة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Angemeldete Accounts bleiben erhalten, damit du sie nächstes Mal direkt nutzen kannst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Signed-in accounts are kept, so you can use them next time."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las cuentas con sesión iniciada se conservan para que las uses la próxima vez."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las cuentas con sesión iniciada se conservan para que las uses la próxima vez."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les comptes connectés sont conservés pour que vous puissiez les réutiliser la prochaine fois."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "साइन इन किए गए खाते बने रहते हैं, ताकि अगली बार आप उनका इस्तेमाल कर सकें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli account collegati restano salvati, così puoi usarli la prossima volta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サインイン済みのアカウントは残るので、次回の追加時にそのまま使えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "로그인한 계정은 유지되므로 다음에 추가할 때 바로 사용할 수 있어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As contas com sessão iniciada são mantidas para você usar da próxima vez."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As contas com sessão iniciada são mantidas para as usares da próxima vez."
          }
        },
        "ru" : {
          "stringUnit" : {
