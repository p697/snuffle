    "%@/年，自动续期，到期前 24 小时取消就不再续费。" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@/سنة، يتجدد تلقائيًا. ألغِ قبل التجديد بـ 24 ساعة على الأقل لإيقافه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@/Jahr, verlängert sich automatisch. Kündige mindestens 24 Stunden vor der Verlängerung, um sie zu beenden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@/year, renews automatically. Cancel at least 24 hours before it renews to stop."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@/año, se renueva automáticamente. Cancela al menos 24 horas antes de la renovación para no pagar más."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@/año, se renueva automáticamente. Cancela al menos 24 horas antes de la renovación para no pagar más."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@/an, renouvelé automatiquement. Annulez au moins 24 heures avant le renouvellement pour l'arrêter."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@/वर्ष, अपने आप रिन्यू होता है। रोकने के लिए रिन्यू होने से कम से कम 24 घंटे पहले रद्द करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@/anno, rinnovo automatico. Annulla almeno 24 ore prima del rinnovo per interromperlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@/年、自動更新。更新の24時間前までにキャンセルすると、更新されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@/년, 자동 갱신돼요. 갱신 24시간 전까지 취소하면 더 이상 결제되지 않아요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@/ano, com renovação automática. Cancele pelo menos 24 horas antes da renovação para não pagar mais."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@/ano, com renovação automática. Cancela pelo menos 24 horas antes da renovação para deixares de pagar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@/год, продлевается автоматически. Чтобы отказаться, отмените не позднее чем за 24 часа до продления."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@/ปี ต่ออายุอัตโนมัติ ยกเลิกอย่างน้อย 24 ชั่วโมงก่อนการต่ออายุเพื่อหยุด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@/yıl, otomatik yenilenir. Durdurmak için yenilemeden en az 24 saat önce iptal edin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@/рік, поновлюється автоматично. Щоб відмовитися, скасуйте щонайменше за 24 години до поновлення."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@/năm, tự động gia hạn. Hủy ít nhất 24 giờ trước khi gia hạn để dừng."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@/年，自動續訂，到期前 24 小時取消即不再續訂。"
          }
        }
      }
    },
