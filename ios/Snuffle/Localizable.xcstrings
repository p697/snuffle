        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "खाता हटाने पर उसका इस्तेमाल करने वाले प्रोजेक्ट उस प्लैटफ़ॉर्म से डिस्कनेक्ट हो जाएँगे और उसकी कुंजी इस iPhone से डिलीट हो जाएगी।"
          }
        },
        "it" : {
          "stringUnit" : {
