        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envía el archivo descargado a este iPhone (AirDrop es lo más rápido) y ábrelo con **Snuffle**, o elige el archivo abajo."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
