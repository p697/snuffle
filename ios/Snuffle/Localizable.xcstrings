    "发过这个事件，才算用过一次。右边是近 7 天的人数。" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يُعدّ الشخص مستخدمًا إلا إذا أرسل هذا الحدث. بجانب كل حدث: الأشخاص خلال آخر 7 أيام."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erst dieses Event zählt als Nutzung. Daneben: Personen der letzten 7 Tage."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sending this event is what counts as using it. Each shows people in the last 7 days."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enviar este evento cuenta como usar el producto. Al lado: personas de los últimos 7 días."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
