          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retirer un compte déconnecte de cette plateforme les projets qui l'utilisent et supprime sa clé de cet iPhone."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "खाता हटाने पर उसका इस्तेमाल करने वाले प्रोजेक्ट उस प्लैटफ़ॉर्म से डिस्कनेक्ट हो जाएँगे और उसकी कुंजी इस iPhone से डिलीट हो जाएगी।"
