        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén pulsado un número y arrástralo sobre otro para intercambiarlos, o a un hueco libre para moverlo allí"
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén presionado un número y arrástralo sobre otro para intercambiarlos, o a un espacio vacío para moverlo ahí"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
