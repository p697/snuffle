          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "บัญชีและคีย์อยู่บน iPhone เครื่องนี้\nและไม่ผ่านเซิร์ฟเวอร์ของเรา"
          }
        },
        "tr" : {
