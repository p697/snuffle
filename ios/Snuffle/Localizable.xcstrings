        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "किसी नंबर को दबाकर रखें और दूसरे नंबर पर खींचें ताकि दोनों की जगह बदल जाए, या खाली जगह पर खींचकर उसे वहाँ ले जाएँ"
