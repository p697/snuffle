    "按住一个数拖到另一个数上，两个换位置；拖到空位就挪过去" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المس رقمًا مطولًا واسحبه فوق رقم آخر لتبديل مكانيهما، أو إلى مكان فارغ لنقله إليه"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte eine Zahl gedrückt und zieh sie auf eine andere, um beide zu tauschen, oder auf einen freien Platz, um sie dorthin zu verschieben"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold a number and drag it onto another to swap them, or onto an empty spot to move it there"
          }
