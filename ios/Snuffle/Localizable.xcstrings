        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al quitar una cuenta, los proyectos que la usan se desconectan de esa plataforma y su clave se elimina de este iPhone."
          }
        },
        "es-419" : {
          "stringUnit" : {
