    "之前的人不算进累计，也不算新增" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يُحتسب من قبل ذلك ضمن الإجمالي ولا ضمن الجدد"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frühere Personen zählen weder zu Gesamt noch als neu"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "People from before count neither in the total nor as new"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quienes llegaron antes no cuentan en el total ni como nuevos"
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quienes llegaron antes no cuentan en el total ni como nuevos"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les personnes d'avant ne comptent ni dans le total ni comme nouvelles"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "उससे पहले के लोग न कुल में गिने जाते हैं, न नए में"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chi è arrivato prima non conta nel totale né tra i nuovi"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "それより前の人は累計にも新規にも含めません"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "그 전의 사람은 누적에도 신규에도 포함하지 않아요"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quem veio antes não entra no total nem conta como novo"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quem veio antes não entra no total nem conta como novo"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Более ранние пользователи не входят ни в общее число, ни в новых"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คนก่อนหน้านั้นไม่นับรวมในยอดทั้งหมดและไม่นับเป็นผู้ใช้ใหม่"
          }
        },
        "tr" : {
