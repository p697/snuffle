          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envoyer cet événement compte comme une utilisation. À côté : personnes sur 7 jours."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह इवेंट भेजने पर ही इस्तेमाल गिना जाता है। साथ में पिछले 7 दिनों के लोग।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inviare questo evento conta come utilizzo del prodotto. Accanto: persone negli ultimi 7 giorni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このイベントを送ると利用したとみなします。右側は直近7日間の人数です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 이벤트를 보내야 사용한 것으로 쳐요. 오른쪽은 최근 7일 사람 수예요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enviar este evento conta como usar o produto. Ao lado: pessoas nos últimos 7 dias."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enviar este evento conta como usar o produto. Ao lado: pessoas nos últimos 7 dias."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отправка этого события считается использованием продукта. Рядом: люди за 7 дней."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ต้องส่งอีเวนต์นี้จึงนับว่าใช้งาน ข้างๆ คือจำนวนคนใน 7 วันล่าสุด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kullanmış sayılmak için bu olayın gönderilmesi gerekir. Yanında: son 7 gündeki kişi sayısı."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Використанням вважається лише надсилання цієї події. Поруч: люди за 7 днів."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phải gửi sự kiện này mới tính là đã dùng. Bên cạnh là số người trong 7 ngày qua."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "發過這個事件，才算用過一次。右邊是近 7 天的人數。"
