    "账号和密钥只存在这台 iPhone 上，\n不会经过我们的服务器。" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تبقى الحسابات والمفاتيح على هذا الـ iPhone\nولا تمر أبدًا عبر خوادمنا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accounts und Schlüssel bleiben auf diesem iPhone\nund laufen nie über unsere Server."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accounts and keys stay on this iPhone\nand never pass through our servers."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las cuentas y claves se quedan en este iPhone\ny nunca pasan por nuestros servidores."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las cuentas y claves se quedan en este iPhone\ny nunca pasan por nuestros servidores."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les comptes et les clés restent sur cet iPhone\net ne passent jamais par nos serveurs."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "खाते और कुंजियाँ इसी iPhone पर रहती हैं\nऔर कभी हमारे सर्वर से नहीं गुज़रतीं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Account e chiavi restano su questo iPhone\ne non passano mai dai nostri server."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アカウントとキーはこのiPhoneにのみ保存され、\n当社のサーバを経由しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "계정과 키는 이 iPhone에만 저장되며\n저희 서버를 거치지 않아요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contas e chaves ficam neste iPhone\ne nunca passam pelos nossos servidores."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
