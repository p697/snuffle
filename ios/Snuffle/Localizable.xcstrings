    "只付一次 %@，一直能用，不会续费。" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ادفع %@ مرة واحدة واحتفظ به إلى الأبد. بلا تجديد."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zahle %@ einmal und nutze es für immer. Keine Verlängerungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pay %@ once and keep it forever. No renewals."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paga %@ una vez y es tuyo para siempre. Sin renovaciones."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paga %@ una vez y es tuyo para siempre. Sin renovaciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Payez %@ une seule fois et c'est à vous pour toujours. Aucun renouvellement."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ एक बार चुकाएँ और हमेशा इस्तेमाल करें। कोई रिन्यूअल नहीं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paga %@ una volta e usalo per sempre. Nessun rinnovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@を1回支払うだけでずっと使えます。更新はありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 한 번 결제로 계속 사용할 수 있어요. 갱신되지 않아요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pague %@ uma vez e use para sempre. Sem renovações."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paga %@ uma vez e fica teu para sempre. Sem renovações."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Заплатите %@ один раз — и пользуйтесь всегда. Без продлений."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "จ่าย %@ ครั้งเดียว ใช้ได้ตลอดไป ไม่มีการต่ออายุ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ bir kez ödeyin, sonsuza dek kullanın. Yenileme yok."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Заплатіть %@ один раз — і користуйтеся завжди. Без поновлень."
