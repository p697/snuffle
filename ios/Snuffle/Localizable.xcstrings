    "权限只开 **Charts metrics: overview** 和 **Project configuration: projects** 的读取，其他保持关闭。" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسمح بالقراءة فقط لـ **Charts metrics: overview** و**Project configuration: projects**، واترك كل شيء آخر متوقفًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaube nur Lesezugriff auf **Charts metrics: overview** und **Project configuration: projects**; alles andere bleibt aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow read access to **Charts metrics: overview** and **Project configuration: projects** only; leave everything else off."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activa solo la lectura de **Charts metrics: overview** y **Project configuration: projects**; deja todo lo demás desactivado."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activa solo la lectura de **Charts metrics: overview** y **Project configuration: projects**; deja todo lo demás desactivado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorisez uniquement l'accès en lecture à **Charts metrics: overview** et **Project configuration: projects** ; laissez tout le reste désactivé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सिर्फ़ **Charts metrics: overview** और **Project configuration: projects** के लिए पढ़ने की अनुमति दें; बाकी सब बंद रखें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
