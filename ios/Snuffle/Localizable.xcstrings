    "读不出这个文件，请确认是 App Store Connect 下载的密钥文件（.p8）" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّرت قراءة هذا الملف. تأكد أنه ملف المفتاح (‎.p8) الذي نزّلته من App Store Connect."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Datei kann nicht gelesen werden. Stelle sicher, dass es die Schlüsseldatei (.p8) aus App Store Connect ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Can't read this file. Make sure it's the key file (.p8) downloaded from App Store Connect."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se puede leer este archivo. Asegúrate de que sea el archivo de clave (.p8) descargado de App Store Connect."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se puede leer este archivo. Asegúrate de que sea el archivo de clave (.p8) descargado de App Store Connect."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de lire ce fichier. Vérifiez qu'il s'agit du fichier de clé (.p8) téléchargé depuis App Store Connect."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह फ़ाइल पढ़ी नहीं जा सकी। पक्का करें कि यह App Store Connect से डाउनलोड की गई कुंजी फ़ाइल (.p8) है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile leggere questo file. Assicurati che sia il file della chiave (.p8) scaricato da App Store Connect."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このファイルを読み込めません。App Store Connectからダウンロードしたキーファイル（.p8）であることを確認してください"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 파일을 읽을 수 없어요. App Store Connect에서 다운로드한 키 파일(.p8)인지 확인하세요"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível ler este arquivo. Verifique se é o arquivo de chave (.p8) baixado do App Store Connect."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
