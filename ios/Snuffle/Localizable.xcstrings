          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store Connectで右上の名前をタップして**プロフィール**を開き、**個人APIキー**で**APIキーを生成**をタップしてダウンロードします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store Connect에서 오른쪽 위의 이름을 탭해 **프로필**로 이동한 뒤, **개인 API 키**에서 **API 키 생성**을 탭하고 다운로드하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
