    "每周用过的里面，第一次来的和回来的；这周还没过完" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "من بين مستخدمي كل أسبوع: القادمون لأول مرة والعائدون؛ ولم ينتهِ هذا الأسبوع بعد"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wer pro Woche aktiv war: zum ersten Mal oder wiederkehrend; diese Woche läuft noch"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Of each week's users, first-timers and returners; this week isn't over yet"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De quienes lo usaron cada semana, los que llegaron por primera vez y los que volvieron; esta semana aún no ha terminado"
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De quienes lo usaron cada semana, los que llegaron por primera vez y los que volvieron; esta semana todavía no termina"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parmi les actifs de chaque semaine, nouveaux et récurrents ; la semaine n'est pas finie"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हर हफ़्ते इस्तेमाल करने वालों में पहली बार आए और लौटे लोग; यह हफ़्ता अभी ख़त्म नहीं हुआ"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tra chi l'ha usato ogni settimana, chi è arrivato per la prima volta e chi è tornato; questa settimana non è ancora finita"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "毎週の利用者のうち、初めての人と戻ってきた人。今週はまだ途中です"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "매주 사용한 사람 중 처음 온 사람과 다시 온 사람. 이번 주는 아직 진행 중이에요"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De quem usou a cada semana, quem chegou pela primeira vez e quem voltou; esta semana ainda não acabou"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De quem usou em cada semana, quem chegou pela primeira vez e quem voltou; esta semana ainda não terminou"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Среди пользовавшихся за неделю — пришедшие впервые и вернувшиеся; эта неделя ещё не закончилась"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ในบรรดาคนที่ใช้งานแต่ละสัปดาห์ แยกเป็นคนที่มาครั้งแรกและคนที่กลับมา สัปดาห์นี้ยังไม่จบ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
