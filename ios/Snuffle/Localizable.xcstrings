        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सिर्फ़ Snuffle में प्रोजेक्ट डिलीट होता है। हर प्लैटफ़ॉर्म का डेटा जस का तस रहता है और साइन इन किए गए खाते बने रहते हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina solo il progetto in Snuffle. I dati sulle piattaforme non vengono toccati e gli account collegati restano salvati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Snuffle内のこのプロジェクトのみ削除します。各プラットフォームのデータは影響を受けず、サインイン済みのアカウントは残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Snuffle의 이 프로젝트만 삭제해요. 각 플랫폼 데이터는 그대로이고 로그인한 계정도 유지돼요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apaga só o projeto no Snuffle. Os dados em cada plataforma não são afetados, e as contas com sessão iniciada são mantidas."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Só apaga o projeto no Snuffle. Os dados em cada plataforma não são afetados e as contas com sessão iniciada são mantidas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удаляет проект только из Snuffle. Данные на платформах не изменятся, аккаунты сохранятся."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ลบเฉพาะโปรเจกต์ใน Snuffle ข้อมูลบนแต่ละแพลตฟอร์มไม่ได้รับผลกระทบ และบัญชีที่ลงชื่อเข้าไว้จะยังอยู่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yalnızca Snuffle’daki projeyi siler. Platformlardaki veriler etkilenmez, giriş yapılmış hesaplar korunur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Видаляє проєкт лише зі Snuffle. Дані на платформах не зміняться, акаунти збережуться."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chỉ xóa dự án trong Snuffle. Dữ liệu trên từng nền tảng không bị ảnh hưởng và các tài khoản đã đăng nhập được giữ lại."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只刪除 Snuffle 裡的這個專案，各平台的資料不受影響，登入過的帳號會保留。"
          }
        }
      }
    },
