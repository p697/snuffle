          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conecta PostHog o la consola de una tienda para ver usuarios nuevos, ingresos y reseñas en cada actualización."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
