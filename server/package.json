{
  "name": "snuffle-server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "types": "wrangler types --strict-vars=false",
    "typecheck": "wrangler types --strict-vars=false --check && tsc --noEmit",
    "test": "vitest run",
    "deploy": "wrangler d1 migrations apply snuffle --remote && wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.6.0",
    "typescript": "6.0.3",
    "vitest": "4.1.12",
    "wrangler": "4.158.0"
  },
  "dependencies": {
    "@peculiar/x509": "1.12.3"
  },
  "packageManager": "pnpm@10.27.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  }
}
