{
  // snuffle.ai: one Worker serves the static site and the drafting API under /api.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "snuffle",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "../site/public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "routes": [{ "pattern": "snuffle.ai", "custom_domain": true }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "snuffle",
      "database_id": "1a0d850c-57c8-4b9b-b162-0850e22855b9",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // Local StoreKit testing signs with a certificate that does not chain to Apple. Never "true" in production.
    "SNUFFLE_ALLOW_XCODE_TRANSACTIONS": "false"
  },
  // Secrets (wrangler secret put): SNUFFLE_<PROVIDER>_API_KEY for the active provider,
  // and optionally LANGFUSE_BASE_URL, LANGFUSE_PUBLIC_KEY, LANGFUSE_SECRET_KEY. See src/env.ts.
  "observability": { "enabled": true }
}
